# egitim.koraytoksoz.com — DreamHost (Apache) ayarları
# Eğitimler alt klasörlerde durur (/yz/, /muzik/ …); her birinin kendi .htaccess'i vardır.
# /yz gibi sonu eğik çizgisiz adresleri /yz/ adresine Apache kendisi yönlendirir (DirectorySlash).

# HTTP'yi HTTPS'e yönlendir
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Metin dosyalarını sıkıştırarak gönder (jpg ve mp3 zaten sıkıştırılmış, dokunma)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Doğru içerik türleri
AddType audio/mpeg .mp3
AddType application/javascript .js
AddDefaultCharset utf-8

# Önbellek
<IfModule mod_headers.c>
  # Sayfanın kendisi: her zaman güncel sürüm kontrol edilsin
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # CSS ve JS: index.html'deki ?v= etiketi değişince yenisi indirilir
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Kapak görüntüleri ve simgeler: bir gün sakla, sonra kontrol et
  <FilesMatch "\.(jpg|png|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# Klasör listelemeyi kapat
Options -Indexes
